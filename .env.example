# Firebase Configuration Template
# Salin file ini menjadi .env di root folder customer-dashboard Anda,
# dan isi nilainya dari Firebase Console -> Project Settings -> General -> Web Apps.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Sheets CSV URL — dapatkan dari File > Share > Publish to web (CSV format)
VITE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=0&single=true&output=csv
