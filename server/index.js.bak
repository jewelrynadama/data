const express = require('express');
const fs = require('fs');
const http = require('http');
const { Server } = require('socket.io');
const cors = require('cors');
const {
  default: makeWASocket,
  useMultiFileAuthState,
  DisconnectReason,
} = require('@whiskeysockets/baileys');
const pino = require('pino');
const qrcode = require('qrcode-terminal');

const app = express();
app.use(cors());

app.get('/debug/contacts', (req, res) => {
  res.json(store.contacts);
});

const server = http.createServer(app);
const io = new Server(server, {
  cors: {
    origin: '*',
    methods: ['GET', 'POST']
  }
});

let sock;
let currentQR = '';
let whatsappStatus = 'DISCONNECTED';

// Simple in-memory store for Baileys v7
const store = {
  chats: {},
  messages: {},
  contacts: {}
};

const STORE_PATH = './store_data.json';
if (fs.existsSync(STORE_PATH)) {
    try {
        const data = JSON.parse(fs.readFileSync(STORE_PATH, 'utf-8'));
        store.chats = data.chats || {};
        store.contacts = data.contacts || {};
        console.log(`Loaded store: ${Object.keys(store.chats).length} chats, ${Object.keys(store.contacts).length} contacts`);
    } catch(e) {
        console.error('Failed to parse store_data.json', e);
    }
}

const saveStore = () => {
    try {
        fs.writeFileSync(STORE_PATH, JSON.stringify({ chats: store.chats, contacts: store.contacts }));
    } catch (e) {
        console.error('Failed to save store', e);
    }
};
setInterval(saveStore, 10000);

async function connectToWhatsApp() {
  const { state, saveCreds } = await useMultiFileAuthState('./baileys_auth_info');

  sock = makeWASocket({
    auth: state,
    logger: pino({ level: 'silent' }),
    syncFullHistory: true
  });

  sock.ev.on('creds.update', saveCreds);

  sock.ev.on('connection.update', (update) => {
    const { connection, lastDisconnect, qr } = update;

    if (qr) {
      whatsappStatus = 'WAITING_FOR_SCAN';
      currentQR = qr;
      io.emit('wa_status', { status: whatsappStatus, qr: currentQR });
      qrcode.generate(qr, { small: true });
    }

    if (connection === 'close') {
      const shouldReconnect = lastDisconnect.error?.output?.statusCode !== DisconnectReason.loggedOut;
      console.log('connection closed due to ', lastDisconnect.error, ', reconnecting ', shouldReconnect);
      whatsappStatus = 'DISCONNECTED';
      io.emit('wa_status', { status: whatsappStatus });
      
      if (shouldReconnect) {
        connectToWhatsApp();
      }
    } else if (connection === 'open') {
      console.log('WhatsApp Client is ready!');
      whatsappStatus = 'CONNECTED';
      currentQR = '';
      io.emit('wa_status', { status: whatsappStatus });
    }
  });

  sock.ev.on('contacts.upsert', (contacts) => {
    for (const contact of contacts) {
      store.contacts[contact.id] = contact;
    }
  });

  sock.ev.on('messaging-history.set', (history) => {
    console.log(`Received history sync: ${history.chats.length} chats, ${history.messages.length} messages, ${history.contacts.length} contacts`);
    
    for (const contact of history.contacts) {
      store.contacts[contact.id] = contact;
    }
    for (const chat of history.chats) {
      store.chats[chat.id] = chat;
    }
    for (const msg of history.messages) {
      const chatId = msg.key.remoteJid;
      if (!store.messages[chatId]) store.messages[chatId] = [];
      store.messages[chatId].push(msg);
    }
  });

  sock.ev.on('chats.upsert', (newChats) => {
    for (const chat of newChats) {
      store.chats[chat.id] = { ...(store.chats[chat.id] || {}), ...chat };
    }
  });

  sock.ev.on('chats.update', (updates) => {
    for (const update of updates) {
      if (store.chats[update.id]) {
        store.chats[update.id] = { ...store.chats[update.id], ...update };
      }
    }
  });

  sock.ev.on('messages.upsert', async m => {
    for (const msg of m.messages) {
      const chatId = msg.key.remoteJid;
      if (!store.messages[chatId]) store.messages[chatId] = [];
      store.messages[chatId].push(msg);

      if (!msg.message || msg.key.fromMe) continue;

      let body = msg.message.conversation || msg.message.extendedTextMessage?.text || '';
      if (!body) continue;

      let senderName = msg.pushName || '';
      if (!senderName) {
        const contact = store.contacts[chatId];
        if (contact) {
          senderName = contact.name || contact.notify || contact.verifiedName || '';
        }
      } else {
        // Save pushName to chat so it persists
        if (!store.chats[chatId]) store.chats[chatId] = { id: chatId };
        store.chats[chatId].name = senderName;
      }

      console.log('Incoming WhatsApp message:', chatId, body);
      const resolvedChatId = resolveJid(chatId);
      io.emit('wa_message_received', {
        from: resolvedChatId,
        senderName: senderName || 'Pengguna WhatsApp',
        body: body,
        timestamp: msg.messageTimestamp,
        type: 'chat'
      });
    }
  });
}

// Helper to resolve @lid to @s.whatsapp.net if possible
const resolveJid = (jid) => {
  if (!jid || !jid.includes('@lid')) return jid;
  const contact = Object.values(store.contacts).find(c => c.lid === jid || c.id === jid);
  if (contact && contact.id && contact.id.includes('@s.whatsapp.net')) {
    return contact.id;
  }
  // Also check if we can find by iterating contacts where lid matches
  for (const c of Object.values(store.contacts)) {
      if (c.lid === jid && c.id) return c.id;
  }
  return jid;
};

io.on('connection', (socket) => {
  console.log('A frontend client connected:', socket.id);
  
  socket.emit('wa_status', { status: whatsappStatus, qr: currentQR });

  socket.on('get_chats', async (callback) => {
    if (whatsappStatus !== 'CONNECTED') {
      return callback({ success: false, error: 'WhatsApp not connected' });
    }
    try {
      const mappedChats = Object.values(store.chats).map(c => {
        let name = c.name || '';
        if (!name) {
          const contact = store.contacts[c.id];
          if (contact) name = contact.name || contact.notify || contact.verifiedName || '';
        }
        
        const resolvedId = resolveJid(c.id);
        const isLid = resolvedId.includes('@lid');
        const rawId = resolvedId.split('@')[0];
        
        let finalName = name;
        if (!finalName || finalName === rawId || finalName === resolvedId) {
            finalName = isLid ? 'Nomor Disembunyikan (Privacy)' : rawId;
        }
        
        return {
          id: resolvedId,
          name: finalName,
          timestamp: c.conversationTimestamp || 0,
          unreadCount: c.unreadCount || 0,
          isGroup: c.id?.includes('@g.us'),
          lastMessage: {
             body: '...',
             type: 'chat',
             timestamp: c.conversationTimestamp || 0
          }
        };
      });

      // Group chats by resolved ID (since sometimes both lid and real ID exist)
      const uniqueChats = [];
      const seenIds = new Set();
      for (const c of mappedChats.sort((a, b) => b.timestamp - a.timestamp)) {
         if (!seenIds.has(c.id)) {
            seenIds.add(c.id);
            uniqueChats.push(c);
         }
      }

      callback({ success: true, chats: uniqueChats });
    } catch (err) {
      console.error('get_chats error:', err);
      callback({ success: false, error: err.message });
    }
  });

  socket.on('get_contacts', async (callback) => {
    callback({ success: true, contacts: Object.values(store.contacts) });
  });

  socket.on('get_messages', async (data, callback) => {
    if (whatsappStatus !== 'CONNECTED') {
      return callback({ success: false, error: 'WhatsApp not connected' });
    }
    try {
      // Find all raw chat IDs that resolve to this requested chatId
      let rawChatIds = [data.chatId];
      if (data.chatId.includes('@s.whatsapp.net')) {
         const matchingContacts = Object.values(store.contacts).filter(c => c.id === data.chatId || c.lid === data.chatId);
         const lids = matchingContacts.map(c => c.lid).filter(Boolean);
         rawChatIds = [...new Set([data.chatId, ...lids])];
      }
      
      let allMessages = [];
      for (const rId of rawChatIds) {
         if (store.messages[rId]) {
            allMessages = allMessages.concat(store.messages[rId]);
         }
      }
      
      allMessages.sort((a, b) => (a.messageTimestamp || 0) - (b.messageTimestamp || 0));
      const limit = data.limit || 50;
      const recentMessages = allMessages.slice(-limit);
      
      const mappedMessages = recentMessages.map(m => {
        const isFromMe = m.key.fromMe;
        const resolvedChatId = resolveJid(m.key.remoteJid);
        return {
          id: m.key.id,
          fromMe: isFromMe,
          body: m.message?.conversation || m.message?.extendedTextMessage?.text || '[Unsupported Message]',
          timestamp: m.messageTimestamp,
          from: isFromMe ? 'me' : resolvedChatId,
          to: isFromMe ? resolvedChatId : 'me',
          type: 'chat'
        };
      });
      
      callback({ success: true, messages: mappedMessages });
    } catch (err) {
      console.error('get_messages error:', err);
      callback({ success: false, error: err.message });
    }
  });

  socket.on('send_message', async (data, callback) => {
    if (whatsappStatus !== 'CONNECTED') {
      return callback({ success: false, error: 'WhatsApp not connected' });
    }
    try {
      const chatId = data.phone.includes('@s.whatsapp.net') || data.phone.includes('@g.us') || data.phone.includes('@c.us') ? data.phone : `${data.phone}@s.whatsapp.net`;
      const sentMsg = await sock.sendMessage(chatId, { text: data.message });
      callback({ success: true, messageId: sentMsg.key.id });
    } catch (err) {
      console.error('send_message error:', err);
      callback({ success: false, error: err.message });
    }
  });

  socket.on('disconnect', () => {
    console.log('Frontend client disconnected:', socket.id);
  });
});

process.on('uncaughtException', err => console.error('Uncaught Exception:', err));
process.on('unhandledRejection', err => console.error('Unhandled Rejection:', err));

const PORT = process.env.PORT || 3001;
server.listen(PORT, () => {
  console.log(`Backend server is running on http://localhost:${PORT}`);
  connectToWhatsApp();
});
